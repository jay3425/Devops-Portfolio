# Copy to .env.local and fill in. Anything left empty is simply hidden in production builds.

# Profile links
VITE_GITHUB_URL=https://github.com/jay3425
VITE_LINKEDIN_URL=https://www.linkedin.com/in/jay-dengle-049952337/
VITE_CONTACT_EMAIL=jaydengle2005@gmail.com
VITE_RESUME_URL=
# Portrait for the About section, e.g. /me.jpg (put the file in /public). Hidden when empty.
VITE_PHOTO_URL=
# Optional custom background track (e.g. /music.mp3 in public/). Empty = generated ambient loop.
VITE_MUSIC_URL=
# Optional privacy-friendly analytics (plausible.io), e.g. jaydengle.vercel.app
VITE_PLAUSIBLE_DOMAIN=
VITE_STATUS=OPEN TO DEVOPS OPPORTUNITIES
# Deployed site URL without trailing slash, used for link-preview image
VITE_SITE_URL=

# Contact form — set ONE of these (see README)
VITE_WEB3FORMS_KEY=7a10b430-d437-4933-8cbd-3b0f24f325d6
VITE_FORM_ENDPOINT=

# Project repositories / live demos (leave demos empty if none exist)
VITE_REPO_NEXOPS=
VITE_REPO_PIPELINE=
VITE_REPO_INFRAWATCH=
VITE_DEMO_NEXOPS=
VITE_DEMO_PIPELINE=
